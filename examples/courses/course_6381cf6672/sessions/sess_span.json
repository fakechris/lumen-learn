尖到红球的高度差：—</span></div>\n  </div>\n  <script>\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0xfcfcfc);\n    const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 100);\n    camera.position.set(4.5, 3.2, 5.5);\n    const renderer = new THREE.WebGLRenderer({ antialias: true });\n    renderer.setPixelRatio(devicePixelRatio);\n    renderer.setSize(innerWidth, innerHeight);\n    document.body.appendChild(renderer.domElement);\n    const controls = new THREE.OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.target.set(0.6, 0.4, 0.6);\n\n    scene.add(new THREE.GridHelper(8, 16, 0xbbbbbb, 0xe5e5e5));\n    scene.add(new THREE.AxesHelper(3));\n\n    // v1 and v2 lie in a tilted plane so the \"floor\" is not the xz grid.\n    const v1 = new THREE.Vector3(2, 0.4, 0.6);\n    const v2 = new THREE.Vector3(0.4, 0.9, 2);\n    const origin = new THREE.Vector3();\n    const arrow = (v, color, len) => new THREE.ArrowHelper(v.clone().normalize(), origin, len ?? v.length(), color, 0.25, 0.12);\n    scene.add(arrow(v1, 0xe05656));\n    scene.add(arrow(v2, 0x2563eb));\n\n    // The span plane, drawn as a large translucent quad through the origin.\n    const n = new THREE.Vector3().crossVectors(v1, v2).normalize();\n    const planeGeo = new THREE.PlaneGeometry(7, 7);\n    const plane = new THREE.Mesh(planeGeo, new THREE.MeshBasicMaterial({ color: 0x10b981, transparent: true, opacity: 0.22, side: THREE.DoubleSide, depthWrite: false }));\n    plane.lookAt(n);\n    scene.add(plane);\n\n    // Purple combination arrow c1 v1 + c2 v2, and a target sphere off the plane.\n    const combo = new THREE.ArrowHelper(new THREE.Vector3(1, 0, 0), origin, 1, 0x8b5cf6, 0.25, 0.12);\n    scene.add(combo);\n    const target = new THREE.Mesh(new THREE.SphereGeometry(0.12, 24, 24), new THREE.MeshBasicMaterial({ color: 0xdc2626 }));\n    target.position.copy(v1.clone().multiplyScalar(0.8).add(v2.clone().multiplyScalar(0.7)).add(n.clone().multiplyScalar(1.2)));\n    scene.add(target);\n    // Dashed drop line from the target down to the plane, to make the \"height\" visible.\n    const foot = target.position.clone().sub(n.clone().multiplyScalar(target.position.dot(n)));\n    const drop = new THREE.Line(new THREE.BufferGeometry().setFromPoints([target.position, foot]),\n      new THREE.LineDashedMaterial({ color: 0xdc2626, dashSize: 0.12, gapSize: 0.08 }));\n    drop.computeLineDistances();\n    scene.add(drop);\n\n    const v3 = arrow(v1.clone().add(v2), 0xf59e0b);\n    v3.visible = false;\n    scene.add(v3);\n\n    function label(text, pos, color) {\n      const c = document.createElement(\"canvas\"); c.width = 256; c.height = 64;\n      const g = c.getContext(\"2d\"); g.font = \"bold 40px sans-serif\"; g.fillStyle = color; g.textAlign = \"center\"; g.fillText(text, 128, 46);\n      const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(c), transparent: true }));\n      s.scale.set(1.2, 0.3, 1); s.position.copy(pos); scene.add(s); return s;\n    }\n    label(\"v1\", v1.clone().multiplyScalar(1.12), \"#e05656\");\n    label(\"v2\", v2.clone().multiplyScalar(1.12), \"#2563eb\");\n    label(\"红球在平面上方\", target.position.clone().add(new THREE.Vector3(0, 0.35, 0)), \"#dc2626\");\n    const v3Label = label(\"v3 = v1 + v2\", v1.clone().add(v2).multiplyScalar(1.1), \"#f59e0b\");\n    v3Label.visible = false;\n\n    const c1 = document.getElementById(\"c1\"), c2 = document.getElementById(\"c2\");\n    const status = document.getElementById(\"status\");\n    function update() {\n      const a = parseFloat(c1.value), b = parseFloat(c2.value);\n      document.getElementById(\"c1v\").textContent = a.toFixed(2);\n      document.getElementById(\"c2v\").textContent = b.toFixed(2);\n      const p = v1.clone().multiplyScalar(a).add(v2.clone().multiplyScalar(b));\n      const len = Math.max(0.001, p.length());\n      combo.setDirection(p.clone().normalize());\n      combo.setLength(len, 0.25, 0.12);\n      const gap = target.position.clone().sub(p).dot(n);\n      status.textContent = `紫色箭头尖到红球的高度差：${gap.toFixed(2)}（永远不会变成 0）`;\n      status.className = \"\";\n    }\n    c1.addEventListener(\"input\", update);\n    c2.addEventListener(\"input\", update);\n    document.getElementById(\"v3\").addEventListener(\"change\", (e) => { v3.visible = e.target.checked; v3Label.visible = e.target.checked; });\n    update();\n\n    addEventListener(\"resize\", () => {\n      camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight);\n    });\n    (function animate() { requestAnimationFrame(animate); controls.update(); renderer.render(scene, camera); })();\n  </script>\n</body>\n</html>\n",
