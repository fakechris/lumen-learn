t x=\"555\" y=\"275\" font-family=\"'LXGW WenKai Lite', sans-serif\" font-size=\"20\" fill=\"#333\">v₂</text>\n  \n  <!-- 右侧小标题 -->\n  <text x=\"540\" y=\"80\" font-family=\"'LXGW WenKai Lite', sans-serif\" font-size=\"22\" fill=\"#333\">只标 v₁、v₂</text>\n  \n  <!-- 右侧平面标注 -->\n  <text x=\"690\" y=\"320\" font-family=\"'LXGW WenKai Lite', sans-serif\" font-size=\"18\" fill=\"#666\" opacity=\"0.8\">平面</text>\n  \n  <!-- 底部对比说明 -->\n  <text x=\"260\" y=\"480\" font-family=\"'LXGW WenKai Lite', sans-serif\" font-size=\"20\" fill=\"#333\">span 相同 → 没有撑出新空间</text>\n  \n  <!-- 底部说明的引线 -->\n  <line x1=\"370\" y1=\"472\" x2=\"370\" y2=\"460\" stroke=\"#4b4b4b\" stroke-width=\"1\" opacity=\"0.5\"/>\n  <line x1=\"430\" y1=\"472\" x2=\"430\" y2=\"460\" stroke=\"#4b4b4b\" stroke-width=\"1\" opacity=\"0.5\"/>\n  \n  <!-- 顶部主标题 -->\n  <text x=\"400\" y=\"45\" font-family=\"'LXGW WenKai Lite', sans-serif\" font-size=\"24\" fill=\"#333\" text-anchor=\"middle\">v₃ 没有撑出新空间</text>\n</svg>",
