      "title": "试试看：能碰到红球吗？",
      "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    html, body { margin: 0; height: 100%; background: #faf8f3; font-family: \"PingFang SC\", \"Hiragino Sans GB\", sans-serif; color: #333; overflow: hidden; }\n    #wrap { position: absolute; inset: 0; display: flex; flex-direction: column; }\n    #plot { flex: 1; min-height: 0; margin: 10px 10px 4px; border: 1px solid #d9d2c3; border-radius: 12px; background: #fbfaf6; cursor: grab; touch-action: none; }\n    #controls { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px 28px; padding: 6px 12px 10px; font-size: 12px; color: #555; }\n    .slider-group { display: flex; align-items: center; gap: 8px; }\n    .slider-group label { font-size: 11px; letter-spacing: .03em; color: #777; }\n    .slider-group input[type=range] { width: 110px; accent-color: #c0392b; }\n    .slider-group .val { font-family: ui-monospace, Menlo, monospace; font-size: 13px; font-weight: 700; color: #c0392b; min-width: 42px; text-align: center; }\n    #readout { display: flex; justify-content: center; align-items: center; gap: 24px; padding: 2px 0 6px; font-size: 12px; color: #666; }\n    #readout .k { display: block; font-size: 11px; letter-spacing: .04em; }\n    #readout .v { display: block; font-family: ui-monospace, Menlo, monospace; font-size: 14px; font-weight: 700; color: #c0392b; min-width: 70px; text-align: center; }\n    #formula { display: inline-block; padding: 3px 12px; border: 1px solid #d9d2c3; border-radius: 6px; background: #fff; font-family: Georgia, \"Times New Roman\", serif; font-style: italic; font-size: 13px; color: #333; }\n    .chk { display: flex; align-items: center; gap: 6px; }\n    .chk input { accent-color: #e67e22; }\n    .chk span { font-size: 12px; color: #555; }\n  </style>\n</head>\n<body>\n  <div id=\"wrap\">\n    <canvas id=\"plot\"></canvas>\n    <div id=\"controls\">\n      <div class=\"slider-group\"><label>c₁</label><input type=\"range\" id=\"c1\" min=\"-2.5\" max=\"2.5\" step=\"0.01\" value=\"1.2\"><span class=\"val\" id=\"c1v\">1.20</span></div>\n      <div class=\"slider-group\"><label>c₂</label><input type=\"range\" id=\"c2\" min=\"-2.5\" max=\"2.5\" step=\"0.01\" value=\"0.8\"><span class=\"val\" id=\"c2v\">0.80</span></div>\n      <div class=\"chk\"><input type=\"checkbox\" id=\"showV3\"><span>显示 v₃ = v₁ + v₂</span></div>\n    </div>\n    <div id=\"readout\">\n      <span><span class=\"k\">高度差 (目标 - 平面点)</span><span class=\"v\" id=\"heightDiff\">—</span></span>\n      <span id=\"formula\">span(v₁, v₂) 平面</span>\n    </div>\n  </div>\n  <script>\n    (function() {\n      // --- 三维向量定义 (固定) ---\n      const v1 = { x: 1.2, y: 0.4, z: 0.2 };   // 红色\n      const v2 = { x: -0.3, y: 1.1, z: 0.5 }; // 蓝色\n      // 目标红球位置 (故意不在平面内)\n      const target = { x: 1.8, y: 1.6, z: 1.9 };\n\n      // --- 投影参数 (旋转视角) ---\n      let rotY = 0.6, rotX = 0.25;\n      const CAM_DIST = 7.5;\n\n      // --- 画布与上下文 ---\n      const canvas = document.getElementById(\"plot\");\n      const ctx = canvas.getContext(\"2d\");\n      let W = 0, H = 0;\n      const PAD = { l: 30, r: 20, t: 20, b: 20 };\n\n      // --- 滑块元素 ---\n      const c1Slider = document.getElementById(\"c1\");\n      const c2Slider = document.getElementById(\"c2\");\n      const c1v = document.getElementById(\"c1v\");\n      const c2v = document.getElementById(\"c2v\");\n      const showV3Chk = document.getElementById(\"showV3\");\n      const heightDiffEl = document.getElementById(\"heightDiff\");\n\n      // --- 辅助函数: 3D旋转投影 (绕Y轴再绕X轴) ---\n      function project(p) {\n        // 绕Y轴\n        const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n        const x1 = p.x * cosY + p.z * sinY;\n        const z1 = -p.x * sinY + p.z * cosY;\n        const y1 = p.y;\n        // 绕X轴\n        const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n        const y2 = y1 * cosX - z1 * sinX;\n        const z2 = y1 * sinX + z1 * cosX;\n        // 透视投影 (简单正交 + 缩放)\n        const scale = 1.0;\n        const px = (x1 * scale) * 60 + W / 2;\n        const py = (-y2 * scale) * 60 + H / 2;\n        return { x: px, y: py, z: z2 };\n      }\n\n      // --- 坐标转换: 屏幕到世界 (用于拖拽旋转) ---\n      function screenToWorld(sx, sy) {\n        // 粗略反向，仅用于旋转增量\n        return { dx: sx - W/2, dy: sy - H/2 };\n      }\n\n      // --- 绘制主函数 ---\n      function draw() {\n        ctx.clearRect(0, 0, W, H);\n        // 背景\n        ctx.fillStyle = \"#fbfaf6\";\n        ctx.fillRect(0, 0, W, H);\n\n        // 读取滑块值\n        const c1 = parseFloat(c1Slider.value);\n        const c2 = parseFloat(c2Slider.value);\n        c1v.textContent = c1.toFixed(2);\n        c2v.textContent = c2.toFixed(2);\n\n        // 计算平面上的点 (紫色箭头终点)\n        const planePoint = {\n          x: c1 * v1.x + c2 * v2.x,\n          y: c1 * v1.y + c2 * v2.y,\n          z: c1 * v1.z + c2 * v2.z\n        };\n\n        // 计算高度差 (目标点 - 平面点) 在法向量方向上的分量\n        // 法向量 = v1 × v2\n        const nx = v1.y * v2.z - v1.z * v2.y;\n        const ny = v1.z * v2.x - v1.x * v2.z;\n        const nz = v1.x * v2.y - v1.y * v2.x;\n        const norm = Math.sqrt(nx*nx + ny*ny + nz*nz);\n        let heightDiff = 0;\n        if (norm > 1e-6) {\n          const diff = { x: target.x - planePoint.x, y: target.y - planePoint.y, z: target.z - planePoint.z };\n          heightDiff = (diff.x * nx + diff.y * ny + diff.z * nz) / norm;\n        }\n        heightDiffEl.textContent = heightDiff.toFixed(3);\n\n        // --- 绘制坐标轴 (浅色) ---\n        ctx.save();\n        ctx.strokeStyle = \"#b9b3a6\";\n        ctx.lineWidth = 1;\n        const origin = project({x:0, y:0, z:0});\n        const xAxis = project({x:2.2, y:0, z:0});\n        const yAxis = project({x:0, y:2.2, z:0});\n        const zAxis = project({x:0, y:0, z:2.2});\n        ctx.beginPath();\n        ctx.moveTo(origin.x, origin.y); ctx.lineTo(xAxis.x, xAxis.y);\n        ctx.moveTo(origin.x, origin.y); ctx.lineTo(yAxis.x, yAxis.y);\n        ctx.moveTo(origin.x, origin.y); ctx.lineTo(zAxis.x, zAxis.y);\n        ctx.stroke();\n        ctx.fillStyle = \"#8a8377\";\n        ctx.font = \"italic 11px Georgia, serif\";\n        ctx.fillText(\"x\", xAxis.x+4, xAxis.y-4);\n        ctx.fillText(\"y\", yAxis.x+4, yAxis.y-4);\n        ctx.fillText(\"z\", zAxis.x+4, zAxis.y-4);\n        ctx.restore();\n\n        // --- 绘制半透明平面 (平行四边形) ---\n        // 平面由 v1, v2 张成，绘制范围 -2..2\n        const corners = [\n          { x: -2*v1.x - 2*v2.x, y: -2*v1.y - 2*v2.y, z: -2*v1.z - 2*v2.z },\n          { x:  2*v1.x - 2*v2.x, y:  2*v1.y - 2*v2.y, z:  2*v1.z - 2*v2.z },\n          { x:  2*v1.x + 2*v2.x, y:  2*v1.y + 2*v2.y, z:  2*v1.z + 2*v2.z },\n          { x: -2*v1.x + 2*v2.x, y: -2*v1.y + 2*v2.y, z: -2*v1.z + 2*v2.z }\n        ];\n        const projCorners = corners.map(c => project(c));\n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(projCorners[0].x, projCorners[0].y);\n        for (let i=1; i<projCorners.length; i++) ctx.lineTo(projCorners[i].x, projCorners[i].y);\n        ctx.closePath();\n        ctx.fillStyle = \"rgba(46, 139, 111, 0.15)\";\n        ctx.fill();\n        ctx.strokeStyle = \"rgba(46, 139, 111, 0.5)\";\n        ctx.lineWidth = 1;\n        ctx.setLineDash([4, 4]);\n        ctx.stroke();\n        ctx.restore();\n\n        // --- 绘制向量 v1 (红色) 和 v2 (蓝色) ---\n        const pv1 = project(v1);\n        const pv2 = project(v2);\n        const pOrigin = project({x:0, y:0, z:0});\n        // v1\n        ctx.save();\n        ctx.strokeStyle = \"#c0392b\";\n        ctx.lineWidth = 2.5;\n        ctx.beginPath();\n        ctx.moveTo(pOrigin.x, pOrigin.y);\n        ctx.lineTo(pv1.x, pv1.y);\n        ctx.stroke();\n        // 箭头\n        ctx.fillStyle = \"#c0392b\";\n        ctx.beginPath();\n        ctx.arc(pv1.x, pv1.y, 4, 0, 2*Math.PI);\n        ctx.fill();\n        ctx.font = \"italic 12px Georgia, serif\";\n        ctx.fillText(\"v₁\", pv1.x+8, pv1.y-6);\n        ctx.restore();\n        // v2\n        ctx.save();\n        ctx.strokeStyle = \"#2c6e9e\";\n        ctx.lineWidth = 2.5;\n        ctx.beginPath();\n        ctx.moveTo(pOrigin.x, pOrigin.y);\n        ctx.lineTo(pv2.x, pv2.y);\n        ctx.stroke();\n        ctx.fillStyle = \"#2c6e9e\";\n        ctx.beginPath();\n        ctx.arc(pv2.x, pv2.y, 4, 0, 2*Math.PI);\n        ctx.fill();\n        ctx.font = \"italic 12px Georgia, serif\";\n        ctx.fillText(\"v₂\", pv2.x+8, pv2.y-6);\n        ctx.restore();\n\n        // --- 如果勾选显示 v3 = v1 + v2 (橙色) ---\n        if (showV3Chk.checked) {\n          const v3 = { x: v1.x + v2.x, y: v1.y + v2.y, z: v1.z + v2.z };\n          const pv3 = project(v3);\n          ctx.save();\n          ctx.strokeStyle = \"#e67e22\";\n          ctx.lineWidth = 2;\n          ctx.setLineDash([6, 3]);\n          ctx.beginPath();\n          ctx.moveTo(pOrigin.x, pOrigin.y);\n          ctx.lineTo(pv3.x, pv3.y);\n          ctx.stroke();\n          ctx.fillStyle = \"#e67e22\";\n          ctx.beginPath();\n          ctx.arc(pv3.x, pv3.y, 4, 0, 2*Math.PI);\n          ctx.fill();\n          ctx.font = \"italic 12px Georgia, serif\";\n          ctx.fillText(\"v₃\", pv3.x+8, pv3.y-6);\n          ctx.restore();\n        }\n\n        // --- 绘制紫色箭头 (c1*v1 + c2*v2) ---\n        const pPlane = project(planePoint);\n        ctx.save();\n        ctx.strokeStyle = \"#8e44ad\";\n        ctx.lineWidth = 2.5;\n        ctx.beginPath();\n        ctx.moveTo(pOrigin.x, pOrigin.y);\n        ctx.lineTo(pPlane.x, pPlane.y);\n        ctx.stroke();\n        ctx.fillStyle = \"#8e44ad\";\n        ctx.beginPath();\n        ctx.arc(pPlane.x, pPlane.y, 4.5, 0, 2*Math.PI);\n        ctx.fill();\n        ctx.font = \"italic 12px Georgia, serif\";\n        ctx.fillText(\"c₁v₁+c₂v₂\", pPlane.x+10, pPlane.y-8);\n        ctx.restore();\n\n        // --- 绘制目标红球 (悬在平面之上) ---\n        const pTarget = project(target);\n        ctx.save();\n        // 虚线垂线: 从平面点垂直向上到目标点 (方向为法向量)\n        // 计算平面点沿法向量方向到目标点的垂足 (其实平面点就是垂足，因为平面点已经在平面上)\n        // 但为了视觉，画一条从平面点到目标点的虚线\n        ctx.strokeStyle = \"rgba(192,57,43,0.6)\";\n        ctx.lineWidth = 1.2;\n        ctx.setLineDash([4, 4]);\n        ctx.beginPath();\n        ctx.moveTo(pPlane.x, pPlane.y);\n        ctx.lineTo(pTarget.x, pTarget.y);\n        ctx.stroke();\n        ctx.restore();\n\n        // 红球\n        ctx.save();\n        ctx.shadowColor = \"transparent\";\n        ctx.fillStyle = \"#c0392b\";\n        ctx.beginPath();\n        ctx.arc(pTarget.x, pTarget.y, 7, 0, 2*Math.PI);\n        ctx.fill();\n        ctx.strokeStyle = \"#a93226\";\n        ctx.lineWidth = 1;\n        ctx.stroke();\n        ctx.fillStyle = \"#fff\";\n        ctx.font = \"italic 11px Georgia, serif\";\n        ctx.fillText(\"目标\", pTarget.x+10, pTarget.y-6);\n        ctx.restore();\n\n        // 在平面点画一个小空心圆表示垂足\n        ctx.save();\n        ctx.strokeStyle = \"#8e44ad\";\n        ctx.lineWidth = 1.5;\n        ctx.beginPath();\n        ctx.arc(pPlane.x, pPlane.y, 3, 0, 2*Math.PI);\n        ctx.stroke();\n        ctx.restore();\n      }\n\n      // --- resize 处理 ---\n      function resize() {\n        const rect = canvas.getBoundingClientRect();\n        W = rect.width;\n        H = rect.height;\n        const dpr = window.devicePixelRatio || 1;\n        canvas.width = Math.round(W * dpr);\n        canvas.height = Math.round(H * dpr);\n        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        draw();\n      }\n\n      // --- 鼠标/触摸旋转 ---\n      let dragging = false;\n      let lastX = 0, lastY = 0;\n\n      function onPointerDown(e) {\n        e.preventDefault();\n        dragging = true;\n        lastX = e.clientX;\n        lastY = e.clientY;\n        canvas.style.cursor = \"grabbing\";\n      }\n      function onPointerMove(e) {\n        if (dragging) {\n          const dx = e.clientX - lastX;\n          const dy = e.clientY - lastY;\n          rotY += dx * 0.01;\n          rotX += dy * 0.01;\n          // 限制 rotX 范围\n          rotX = Math.max(-1.2, Math.min(1.2, rotX));\n          lastX = e.clientX;\n          lastY = e.clientY;\n          draw();\n        }\n      }\n      function onPointerUp(e) {\n        dragging = false;\n        canvas.style.cursor = \"grab\";\n      }\n\n      // --- 事件绑定 ---\n      canvas.addEventListener(\"pointerdown\", onPointerDown);\n      canvas.addEventListener(\"pointermove\", onPointerMove);\n      canvas.addEventListener(\"pointerup\", onPointerUp);\n      canvas.addEventListener(\"pointerleave\", onPointerUp);\n      // 滑块事件\n      c1Slider.addEventListener(\"input\", draw);\n      c2Slider.addEventListener(\"input\", draw);\n      showV3Chk.addEventListener(\"change\", draw);\n      window.addEventListener(\"resize\", resize);\n\n      // 初始化\n      resize();\n    })();\n  </script>\n</body>\n</html>",
      "layout": "newcol",
      "reveal_gate_step": 9
    },
