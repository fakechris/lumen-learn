      "widget": {
        "kind": "explorable",
        "title": "滑动探针：红点永远在两片面包之间",
        "task": "画 f(x)=x²·sin(1/x)（红）与包络 y=x²、y=-x²（绿色虚线），x 范围 ±0.32；探针读出当前 X 与 F(X)。",
        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    html, body { margin: 0; height: 100%; background: #faf8f3; font-family: \"PingFang SC\", \"Hiragino Sans GB\", sans-serif; color: #333; overflow: hidden; }\n    #wrap { position: absolute; inset: 0; display: flex; flex-direction: column; }\n    #plot { flex: 1; min-height: 0; margin: 10px 10px 4px; border: 1px solid #d9d2c3; border-radius: 12px; background: #fbfaf6; cursor: crosshair; touch-action: none; }\n    #readout { display: flex; justify-content: center; align-items: center; gap: 28px; padding: 4px 0 8px; font-size: 12px; color: #666; }\n    #readout .k { display: block; font-size: 11px; letter-spacing: .04em; }\n    #readout .v { display: block; font-family: ui-monospace, Menlo, monospace; font-size: 14px; font-weight: 700; color: #c0392b; min-width: 64px; text-align: center; }\n    #formula { display: inline-block; padding: 3px 10px; border: 1px solid #d9d2c3; border-radius: 6px; background: #fff; font-family: Georgia, \"Times New Roman\", serif; font-style: italic; font-size: 13px; color: #333; }\n  </style>\n</head>\n<body>\n  <div id=\"wrap\">\n    <canvas id=\"plot\"></canvas>\n    <div id=\"readout\">\n      <span><span class=\"k\">当前 X</span><span class=\"v\" id=\"rx\">—</span></span>\n      <span><span class=\"k\">F(X)</span><span class=\"v\" id=\"ry\">—</span></span>\n      <span id=\"formula\">f(x) = x² · sin(1/x)</span>\n    </div>\n  </div>\n  <script>\n    // --- the thing being explored -------------------------------------\n    const f = (x) => (x === 0 ? 0 : x * x * Math.sin(1 / x));\n    const upper = (x) => x * x, lower = (x) => -x * x;\n    const X_MIN = -0.32, X_MAX = 0.32, Y_MIN = -0.075, Y_MAX = 0.075;\n\n    // --- plumbing ------------------------------------------------------\n    const canvas = document.getElementById(\"plot\");\n    const ctx = canvas.getContext(\"2d\");\n    let W = 0, H = 0, probeX = null;\n    const PAD = { l: 34, r: 18, t: 18, b: 26 };\n    const sx = (x) => PAD.l + (x - X_MIN) / (X_MAX - X_MIN) * (W - PAD.l - PAD.r);\n    const sy = (y) => PAD.t + (Y_MAX - y) / (Y_MAX - Y_MIN) * (H - PAD.t - PAD.b);\n    const ux = (px) => X_MIN + (px - PAD.l) / (W - PAD.l - PAD.r) * (X_MAX - X_MIN);\n\n    function resize() {\n      const r = canvas.getBoundingClientRect();\n      W = r.width; H = r.height;\n      const dpr = window.devicePixelRatio || 1;\n      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);\n      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n      draw();\n    }\n\n    function curve(fn, style) {\n      ctx.save(); Object.assign(ctx, style.props || {});\n      if (style.dash) ctx.setLineDash(style.dash);\n      ctx.beginPath();\n      const n = 1600; let started = false;\n      for (let i = 0; i <= n; i++) {\n        const x = X_MIN + (X_MAX - X_MIN) * i / n, y = fn(x);\n        if (!isFinite(y)) { started = false; continue; }\n        const px = sx(x), py = sy(Math.max(Y_MIN * 1.3, Math.min(Y_MAX * 1.3, y)));\n        started ? ctx.lineTo(px, py) : ctx.moveTo(px, py); started = true;\n      }\n      ctx.stroke(); ctx.restore();\n    }\n\n    function label(text, x, y, color, align = \"left\") {\n      ctx.save(); ctx.font = \"italic 12px Georgia, serif\"; ctx.fillStyle = color; ctx.textAlign = align; ctx.fillText(text, x, y); ctx.restore();\n    }\n\n    function draw() {\n      ctx.clearRect(0, 0, W, H);\n      // axes\n      ctx.save(); ctx.strokeStyle = \"#b9b3a6\"; ctx.lineWidth = 1;\n      ctx.beginPath(); ctx.moveTo(PAD.l, sy(0)); ctx.lineTo(W - PAD.r, sy(0)); ctx.moveTo(sx(0), PAD.t); ctx.lineTo(sx(0), H - PAD.b); ctx.stroke();\n      ctx.fillStyle = \"#8a8377\"; ctx.font = \"italic 11px Georgia, serif\"; ctx.textAlign = \"center\";\n      for (const x of [-0.2, 0.2]) { ctx.beginPath(); ctx.moveTo(sx(x), sy(0) - 3); ctx.lineTo(sx(x), sy(0) + 3); ctx.stroke(); ctx.fillText(x, sx(x), sy(0) + 14); }\n      ctx.textAlign = \"right\";\n      for (const y of [-0.04, 0.04]) { ctx.beginPath(); ctx.moveTo(sx(0) - 3, sy(y)); ctx.lineTo(sx(0) + 3, sy(y)); ctx.stroke(); ctx.fillText(y, sx(0) - 6, sy(y) + 4); }\n      ctx.fillText(\"x\", W - PAD.r - 2, sy(0) - 6); ctx.textAlign = \"left\"; ctx.fillText(\"y\", sx(0) + 6, PAD.t + 8);\n      ctx.restore();\n      // envelopes (the \"bread\")\n      curve(upper, { props: { strokeStyle: \"#2e8b6f\", lineWidth: 1.2 }, dash: [5, 4] });\n      curve(lower, { props: { strokeStyle: \"#2e8b6f\", lineWidth: 1.2 }, dash: [5, 4] });\n      label(\"y = x²\", sx(0.24), sy(upper(0.24)) - 8, \"#2e8b6f\");\n      label(\"y = -x²\", sx(0.24), sy(lower(0.24)) + 14, \"#2e8b6f\");\n      // the function (the \"filling\")\n      curve(f, { props: { strokeStyle: \"#c0392b\", lineWidth: 2 } });\n      // probe\n      if (probeX !== null) {\n        const px = sx(probeX), y = f(probeX), py = sy(y);\n        ctx.save(); ctx.strokeStyle = \"rgba(192,57,43,.55)\"; ctx.setLineDash([3, 4]); ctx.lineWidth = 1;\n        ctx.beginPath(); ctx.moveTo(px, PAD.t); ctx.lineTo(px, H - PAD.b); ctx.stroke(); ctx.restore();\n        ctx.save(); ctx.fillStyle = \"#c0392b\"; ctx.beginPath(); ctx.arc(px, py, 4, 0, Math.PI * 2); ctx.fill(); ctx.restore();\n        document.getElementById(\"rx\").textContent = probeX.toFixed(3);\n        document.getElementById(\"ry\").textContent = y.toFixed(3);\n      }\n    }\n\n    function onPointer(e) {\n      const r = canvas.getBoundingClientRect();\n      probeX = Math.max(X_MIN, Math.min(X_MAX, ux(e.clientX - r.left)));\n      draw();\n    }\n    canvas.addEventListener(\"pointermove\", onPointer);\n    canvas.addEventListener(\"pointerdown\", onPointer);\n    window.addEventListener(\"resize\", resize);\n    resize();\n  </script>\n</body>\n</html>\n",
